APP_NAME=streaming
APP_ENV=prod

GRPC_PORT=50051
WEBSOCKET_PORT=8080

DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/streaming
DATABASE_DIRECT_URL=postgresql://postgres:postgres@postgres:5432/streaming

SERVICE_AUTH_URL=auth:50051
SERVICE_PROFILE_URL=profile:50051
SERVICE_ENGINE_URL=engine:50051
SERVICE_BATTLE_URL=battle:50051
SERVICE_MATCHMAKING_URL=matchmaking:50051

IDDLE_WEBSOCKET_TIME_LIMIT=300

BATTLE_IDLE_TIMEOUT_SECONDS=180
BATTLE_POLL_INTERVAL_SECONDS=10

PG_BOSS_MAX=5
PG_BOSS_MAINTENANCE_INTERVAL_SECONDS=60
PG_BOSS_APPLICATION_NAME=streaming-pg-boss

ACCESS_SECRET=your_access_secret
REFRESH_SECRET=your_refresh_secret

KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=streaming-client
MESSAGE_PRODUCER_TOPIC_BOT_CONNECTING_REQUEST=bot.connecting-request
